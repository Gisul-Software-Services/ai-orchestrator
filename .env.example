# Copy to `.env` in the repo root for `docker compose` variable substitution.
# Keep the same ADMIN_API_KEY value in frontend and gateway (see docker-compose.yml).

ADMIN_TOKEN=change-me

# Single shared secret: frontend proxy sends this as X-Api-Key to the gateway.
ADMIN_API_KEY=change-me

# Local dev: false. Production: true.
REQUIRE_VERIFIED_ORG_FOR_GENERATION=false

# AIML generation mode
# true  -> library-first endpoint uses 2-pass generation where enabled
# false -> richer single-pass generation (requires larger VLLM_MAX_MODEL_LEN)
AIML_TWO_PASS_GENERATION=true

# Single-pass (library) generation output budget (helps reach 5 tasks).
AIML_TWO_PASS_P1_MAX_TOKENS=800

# Do not fetch dataset preview rows during generation responses.
AIML_LIBRARY_DATA_PREVIEW=false

IMAGE_TAG=latest

# Copy to `backend/gateway/.env` (used by docker-compose `env_file` for backend-api).
# Values here are overridden by `environment:` entries in docker-compose.yml when set.

MONGODB_URI=mongodb://localhost:27017
BILLING_DB_NAME=aaptor_model
ORGANIZATION_DB_NAME=organization_db
REDIS_URL=redis://redis:6379
MODEL_SERVICE_URL=http://model-service:7001

# Must match the gateway container env `ADMIN_API_KEY` and the frontend `ADMIN_API_KEY`
# (Next `/api/admin/*` proxy sends this value as `X-Api-Key` to bypass org gate when enabled).
ADMIN_API_KEY=change-me

# Next.js admin login (docker-compose `frontend` loads this file for containerized UI).
ADMIN_TOKEN=change-me

# Optional: default org for playground when REQUIRE_VERIFIED_ORG_FOR_GENERATION=true and
# the client did not send org_id (Next proxy maps this to X-Org-Id). Must exist in organization_db.
# PLAYGROUND_ORG_ID=ORG001

# Production: true. Local / playground: false (or rely on compose default false).
REQUIRE_VERIFIED_ORG_FOR_GENERATION=false
